---
title: Database content
---
erDiagram
    User{
        id id PK
        timestamp created_at
        timestamp updated_at
        string name
        string email UK
        timestamp email_verified_at "Null"
        string password
        id lang FK "Null"
        string remember_token "Null"
        }
    Lang {
        string code PK
        string bgg_id
        string bgg_string
    }

    Game {
        id id PK
        timestamp created_at
        timestamp updated_at
        timestamp last_sync_at
        string src "Should be one of the keys, in the ''app.src_list'' config options"
        string src_id
        string thumb_url "Null"
        string thumb_hash "Null"
        string thumb_blurhash "Null"
        string image_url "Null"
        string image_hash "Null"
        string image_blurhash "Null"
        int pub_year "Null"
        int min_players "Null"
        int max_players "Null"
        int min_age "Null"
        int box_time "Null"
        int min_time "Null"
        int max_time "Null"
        string name
        string version_of FK "Null"
        string desc_tl_id FK
    }
    TranslationKey {
        id id PK
        string hash "Unique"
        string context "Null"
    }
    Translation {
        id id PK
        id translation_id FK
        string lang FK
        text text
    }
    Question {
        id id PK
        string question_id
        longText question
        id translation_id FK
        int maxVal "Null"
        int minVal "Null"
    }
    Answer {
        id id PK
        id writer_id FK
        string question_id FK
        string game_id FK
        int answer
    }
    Comment {
        id id PK
        timestamp created_at
        timestamp updated_at
        id translation_id FK
        string lang FK
        string game_id FK
        id writer_id FK
        id editor_id FK "Null"
    }
    GameRole{
        id id PK
        timestamp created_at
        timestamp updated_at
        string src_id
        string role "Can be: Publisher, Designer, Artist"
        string game_id FK
        string name
    }
    User one or zero -- 0+ Comment  : edits
    User 1 -- 0+ Comment : writes
    Comment 1 -- 0+ Game : on
    Game 1 -- one or zero Game : "version of"
    Game 1+ -- 0+ Lang : "is available in"
    Game 0+ -- 1 GameRole: "worked on"
    Comment 1 -- 1+ Lang: "is in"
    User 1 -- 1+ Lang: speaks
    Answer 1 -- 0+ Game: "evaluated on"
    Answer 1 -- 0+ Question: "answer of"
    User 1+ -- 1+ Answer: "written by"
    Translation 1 -- 1+ Lang: "translated to"
    TranslationKey 1 -- 1+ Translation: "Translated by"
    Game 1 -- 1 TranslationKey: "description translation"
    Comment 1 -- 1 TranslationKey: "commment translation"
    Question 1 -- 1 TranslationKey: "question translation"
